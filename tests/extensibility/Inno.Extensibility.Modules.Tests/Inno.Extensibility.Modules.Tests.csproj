<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/foundation/core/Inno.Core.Execution/Inno.Core.Execution.csproj" PrivateAssets="compile" />
    <ProjectReference Include="../../../src/foundation/extensibility/Inno.Extensibility.Reload/Inno.Extensibility.Reload.csproj" />
    <ProjectReference Include="../../../src/foundation/extensibility/Inno.Extensibility.Modules/Inno.Extensibility.Modules.csproj" PrivateAssets="compile" />
    <ProjectReference Include="../../../src/foundation/extensibility/Inno.Extensibility.Types/Inno.Extensibility.Types.csproj" PrivateAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../fixtures/Inno.Extensibility.Modules.TestModule.V1/Inno.Extensibility.Modules.TestModule.V1.csproj" ReferenceOutputAssembly="false" OutputItemType="TestModuleV1" PrivateAssets="compile" />
    <ProjectReference Include="../fixtures/Inno.Extensibility.Modules.TestModule.V2/Inno.Extensibility.Modules.TestModule.V2.csproj" ReferenceOutputAssembly="false" OutputItemType="TestModuleV2" PrivateAssets="compile" />
    <ProjectReference Include="../fixtures/Inno.Extensibility.Modules.TestModule.Invalid/Inno.Extensibility.Modules.TestModule.Invalid.csproj" ReferenceOutputAssembly="false" OutputItemType="TestModuleInvalid" PrivateAssets="compile" />
    <ProjectReference Include="../fixtures/Inno.Extensibility.Modules.TestDependency/Inno.Extensibility.Modules.TestDependency.csproj" ReferenceOutputAssembly="false" OutputItemType="TestModuleDependency" PrivateAssets="compile" />
  </ItemGroup>

  <Target Name="CopyAssemblyTestModules" AfterTargets="Build">
    <Copy SourceFiles="@(TestModuleV1)" DestinationFolder="$(OutDir)Modules/V1" />
    <Copy SourceFiles="@(TestModuleV2)" DestinationFolder="$(OutDir)Modules/V2" />
    <Copy SourceFiles="@(TestModuleInvalid)" DestinationFolder="$(OutDir)Modules/Invalid" />
    <Copy SourceFiles="@(TestModuleDependency)" DestinationFolder="$(OutDir)Modules/V1" />
    <Copy SourceFiles="@(TestModuleDependency)" DestinationFolder="$(OutDir)Modules/V2" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../../../backends/DotNet/runtime/Inno.Adapter.Modules.DotNet/Inno.Adapter.Modules.DotNet.csproj" PrivateAssets="compile" />
  </ItemGroup>
</Project>
