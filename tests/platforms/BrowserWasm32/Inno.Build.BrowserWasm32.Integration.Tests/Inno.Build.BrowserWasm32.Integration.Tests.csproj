<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <InnoValidationLayer>product</InnoValidationLayer>
    <InnoValidationEnvironment>windows</InnoValidationEnvironment>
  </PropertyGroup>
  <Import Project="../../../RepositoryInput.targets" />
  <ItemGroup>
    <InnoNativeDependency Include="player" TargetId="browser-wasm" Configuration="Release" />
    <InnoNativeDependency Include="shader-tools" TargetId="$(InnoToolTarget)" Configuration="Release" Condition="'$(InnoToolTarget)' != ''" />
    <ProjectReference Include="../../../../build/distributions/Inno.Build.Distribution.Standard/Inno.Build.Distribution.Standard.csproj" />
    <ProjectReference Include="../../../../build/composition/Inno.Build.Composition/Inno.Build.Composition.csproj" />
    <ProjectReference Include="../../../../build/support/Inno.Build.SupportPacks.Core/Inno.Build.SupportPacks.Core.csproj" />
    <ProjectReference Include="../../../../build/toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <ProjectReference Include="../../../../build/pipeline/Inno.Build/Inno.Build.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" PrivateAssets="all" />
  </ItemGroup>
</Project>
