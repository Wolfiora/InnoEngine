<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InnoValidationLayer>integration</InnoValidationLayer>
  </PropertyGroup>

  <Import Project="../../RepositoryInput.targets" />

  <ItemGroup>
    <InnoValidationInput Include="../../ci/Get-DocumentationExampleReceipt.ps1;../../ci/Get-DocumentationSourceInputs.ps1" />
    <ProjectReference Include="../../../tools/Inno.Tooling.Documentation/Inno.Tooling.Documentation.csproj" />
    <ProjectReference Include="../../../tools/Inno.Tooling.Architecture/Inno.Tooling.Architecture.csproj" />
    <ProjectReference Include="../../../build/toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CaptureDocumentationFrameworkReferences" AfterTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_DocumentationFrameworkReferences Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
      <FileWrites Include="$(TargetDir)DocumentationFrameworkReferences.txt" />
    </ItemGroup>
    <Error Condition="'@(_DocumentationFrameworkReferences)' == ''" Text="Documentation fixtures require the SDK-evaluated .NET framework references." />
    <MakeDir Directories="$(TargetDir)" />
    <WriteLinesToFile File="$(TargetDir)DocumentationFrameworkReferences.txt" Lines="@(_DocumentationFrameworkReferences->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
</Project>
