<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <Import Project="../../RepositoryInput.targets" />

  <ItemGroup>
    <ProjectReference Include="../../../tools/Inno.Tooling.Architecture/Inno.Tooling.Architecture.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CaptureWikiFrameworkReferences" AfterTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_WikiFrameworkReferences Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
      <FileWrites Include="$(TargetDir)WikiFrameworkReferences.txt" />
    </ItemGroup>
    <Error Condition="'@(_WikiFrameworkReferences)' == ''" Text="Wiki fixtures require the SDK-evaluated .NET framework references." />
    <MakeDir Directories="$(TargetDir)" />
    <WriteLinesToFile File="$(TargetDir)WikiFrameworkReferences.txt" Lines="@(_WikiFrameworkReferences->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
</Project>
