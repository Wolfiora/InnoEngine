<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <InnoValidationLayer>integration</InnoValidationLayer>
  </PropertyGroup>
  <Import Project="../../RepositoryInput.targets" />
  <ItemGroup>
    <ProjectReference Include="../../../build/toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <ProjectReference Include="../../../src/foundation/core/Inno.Core.IO/Inno.Core.IO.csproj" />
  </ItemGroup>
  <!-- These SDK subprocesses read product declarations without linking the product into the test assembly. -->
  <ItemGroup>
    <InnoValidationInput Include="../../../platforms/WindowsX64/build/Inno.Build.WindowsX64/*.props" />
    <InnoValidationInput Include="../../../platforms/MacOSArm64/build/Inno.Build.MacOSArm64/*.props" />
    <InnoValidationInput Include="../../../platforms/BrowserWasm32/build/Inno.Build.BrowserWasm32/ProductBuild.props" />
    <InnoValidationInput Include="../../../entry/InnoEngine.Editor/InnoEngine.Editor.csproj" />
    <InnoValidationInput Include="../../../platforms/WindowsX64/editor/Inno.Editor.WindowsX64/Inno.Editor.WindowsX64.csproj" />
    <InnoValidationInput Include="../../../platforms/MacOSArm64/editor/Inno.Editor.MacOSArm64/Inno.Editor.MacOSArm64.csproj" />
    <InnoValidationInput Include="../../../backends/Sdl3/runtime/Inno.Adapter.Platform.Sdl3/Inno.Adapter.Platform.Sdl3.csproj" />
    <InnoValidationInput Include="../../../backends/Bgfx/runtime/Inno.Adapter.Rendering.Bgfx/Inno.Adapter.Rendering.Bgfx.csproj" />
    <InnoValidationInput Include="../../../backends/Bgfx/native/Inno.Native.Bgfx/Inno.Native.Bgfx.csproj;../../../backends/Bgfx/native/Inno.Native.Bgfx/Bindings/bindings.props" />
    <InnoValidationInput Include="../../../backends/ImGui/runtime/Inno.Adapter.Presentation.ImGui.Bgfx/Inno.Adapter.Presentation.ImGui.Bgfx.csproj" />
    <InnoValidationInput Include="../../../backends/Directory.Build.props;../../../backends/Directory.Build.targets;../../../src/Directory.Build.props" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" PrivateAssets="all" />
    <AssemblyAttribute Include="Xunit.CollectionBehaviorAttribute">
      <DisableTestParallelization>true</DisableTestParallelization>
      <DisableTestParallelization_TypeName>System.Boolean</DisableTestParallelization_TypeName>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
