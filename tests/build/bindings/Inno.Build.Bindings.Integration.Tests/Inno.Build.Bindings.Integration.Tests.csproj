<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InnoValidationLayer>integration</InnoValidationLayer>
    <InnoValidationEnvironment>windows;macos;linux</InnoValidationEnvironment>
  </PropertyGroup>
  <Import Project="../../../RepositoryInput.targets" />
  <ItemGroup>
    <InnoValidationSubject Include="../../../../build/bindings/Inno.Build.Bindings/Inno.Build.Bindings.csproj" />
    <InnoValidationSubject Include="../../../../build/tasks/Inno.Build.TaskHosting/Inno.Build.TaskHosting.csproj" />
    <InnoValidationSubject Include="../../../../build/toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <ProjectReference Include="../../../../build/bindings/Inno.Build.Bindings/Inno.Build.Bindings.csproj" />
    <ProjectReference Include="../../../../build/tasks/Inno.Build.TaskHosting/Inno.Build.TaskHosting.csproj" />
    <ProjectReference Include="../../../../build/toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <ProjectReference Include="../../../../src/foundation/core/Inno.Core.IO/Inno.Core.IO.csproj" />
    <ProjectReference Include="../../../support/Inno.Testing.Source/Inno.Testing.Source.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build" Version="18.9.6" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    <PackageReference Include="BGCS" Version="[$(InnoBgcsPackageVersion)]" PrivateAssets="all" />
    <PackageReference Include="BGCS.Runtime" Version="[$(InnoBgcsPackageVersion)]" />
    <PackageReference Include="BGCS.Extension.BrowserWasm" Version="[$(InnoBgcsPackageVersion)]" PrivateAssets="all" />
  </ItemGroup>
</Project>
