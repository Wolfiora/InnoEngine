<Project>
  <PropertyGroup>
    <InnoTaskProject>$(MSBuildThisFileDirectory)../tasks/Inno.Build.Tasks/Inno.Build.Tasks.csproj</InnoTaskProject>
    <InnoTaskPublisherProject>$(MSBuildThisFileDirectory)../tasks/Inno.Build.TaskHosting/Inno.Build.TaskHosting.csproj</InnoTaskPublisherProject>
    <InnoTaskArtifacts>$(MSBuildThisFileDirectory)../../artifacts/build-tools/tasks</InnoTaskArtifacts>
    <InnoTaskBootstrapOwner Condition="'$(InnoTaskBootstrapOwner)' == ''">$([System.Guid]::NewGuid().ToString('N'))</InnoTaskBootstrapOwner>
    <InnoTaskBootstrapDirectory>$(InnoTaskArtifacts)/publishers/$(InnoTaskBootstrapOwner)/$(Configuration)</InnoTaskBootstrapDirectory>
    <InnoTaskLoadId>$([System.Guid]::NewGuid().ToString('N'))</InnoTaskLoadId>
    <InnoTaskLoadDirectory>$(InnoTaskArtifacts)/loads/$(InnoTaskLoadId)/$(Configuration)</InnoTaskLoadDirectory>
    <InnoTaskHostAssembly>$(InnoTaskLoadDirectory)/Inno.Build.Tasks.dll</InnoTaskHostAssembly>
    <InnoTaskPublisherDirectory>$(InnoTaskArtifacts)/publishers/$(InnoTaskLoadId)/$(Configuration)</InnoTaskPublisherDirectory>
    <InnoTaskPublisherAssembly>$(InnoTaskPublisherDirectory)/Inno.Build.TaskHosting.dll</InnoTaskPublisherAssembly>
    <InnoTaskHostProperties>Configuration=$(Configuration);BuildProjectReferences=true</InnoTaskHostProperties>
    <InnoCompilerToolExcludedProperties>InnoProductId;InnoProductTarget;InnoProductBuildProperties;InnoBgfxShaderTarget;InnoBgfxShaderApis;InnoImGuiShaderTarget;InnoImGuiShaderApis;InnoProductRestore;InnoToolTarget;InnoPrepareProductNative;InnoNativeTarget;InnoNativeBuildFingerprint;InnoNativeBindingSelection;InnoNativeLibraryKind;InnoNativeRuntimeImports;RuntimeIdentifier;RuntimeIdentifiers;TargetFramework;TargetFrameworks;InnoBindingEngineRoot;InnoBindingDefinition;InnoBindingTargetId;InnoBindingOutputMode;InnoBindingDotnetHost;BindGenOutputDirectory;BindGenGeneratedSource;BindGenGenerationFingerprint;BindGenDescriptorOutput;BindGenExpectedFingerprint;DebugType;DebugSymbols;DefineConstants;PublishAot;RunAOTCompilation;PublishTrimmed;SelfContained;PublishSingleFile;PublishDir;WasmBuildNative;InnoGeneratePlayerComposition;ArtifactsPivots;UseArtifactsOutput;MSBuildProjectExtensionsPath;BaseOutputPath;BaseIntermediateOutputPath;OutputPath;IntermediateOutputPath;IsCrossTargetingBuild</InnoCompilerToolExcludedProperties>
    <InnoCompilerToolExcludedProperties>$(InnoCompilerToolExcludedProperties);InnoShaderToolSourceRoot</InnoCompilerToolExcludedProperties>
    <!-- Compiler references stay in the solution build; private task preparation owns a separate graph. -->
    <InnoTaskExcludedProperties>$(InnoCompilerToolExcludedProperties);BuildingInsideVisualStudio;BuildingSolutionFile;CurrentSolutionConfigurationContents;DesignTimeBuild</InnoTaskExcludedProperties>
    <!-- Tool restore has its own project closure, independent of the IDE solution. -->
    <InnoTaskExcludedProperties>$(InnoTaskExcludedProperties);SolutionPath;SolutionDir;SolutionName;SolutionFileName;SolutionExt;RestoreGraphProjectInput;_RestoreSolutionFileUsed;InnoTaskBootstrapOwner</InnoTaskExcludedProperties>
  </PropertyGroup>

  <UsingTask TaskName="Inno.Build.Tasks.GenerateBindingsTask" AssemblyFile="$(InnoTaskHostAssembly)" />
  <UsingTask TaskName="Inno.Build.TaskHosting.MaterializeBindingsTask" AssemblyFile="$(InnoTaskPublisherAssembly)" />
  <UsingTask TaskName="Inno.Build.TaskHosting.RegisterTaskPublisherTask" AssemblyFile="$(InnoTaskPublisherAssembly)" />
  <UsingTask TaskName="Inno.Build.Tasks.CompileShaderTask" AssemblyFile="$(InnoTaskHostAssembly)" />
  <UsingTask TaskName="Inno.Build.Tasks.PublishSupportPackTask" AssemblyFile="$(InnoTaskHostAssembly)" />
  <UsingTask TaskName="Inno.Build.Tasks.PrepareProductNativeTask" AssemblyFile="$(InnoTaskHostAssembly)" />
  <UsingTask TaskName="Inno.Build.Tasks.MaintainBuildCachesTask" AssemblyFile="$(InnoTaskHostAssembly)" />
  <UsingTask TaskName="Inno.Build.TaskHosting.PublishTaskHostTask" AssemblyFile="$(InnoTaskPublisherAssembly)" />
  <UsingTask TaskName="Inno.Build.TaskHosting.BuildTaskRuntimeTask" AssemblyFile="$(InnoTaskPublisherAssembly)" />
  <UsingTask TaskName="Inno.Build.TaskHosting.RestoreOwnedProjectTask" AssemblyFile="$(InnoTaskPublisherAssembly)" />

  <!-- A worker can rebuild the task registry while retaining the IDE's evaluated properties. -->
  <UsingTask
    TaskName="InnoTaskRuntimeLoadIdentity"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Identity ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        Identity = "$(InnoTaskLoadId)";
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Private loader copies belong to the operation lifetime, not reusable project outputs. -->
  <UsingTask
    TaskName="InnoMaterializePrivateRuntime"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Reference Include="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll" />
      <Code Type="Class" Language="cs"><![CDATA[
        /// <summary>Prepares loader-owned files using the SDK copy and cancellation protocol.</summary>
        public sealed class InnoMaterializePrivateRuntime : Microsoft.Build.Utilities.Task, Microsoft.Build.Framework.ICancelableTask
        {
          private readonly Microsoft.Build.Tasks.Copy m_copy = new Microsoft.Build.Tasks.Copy();

          /// <summary>Gets or sets the complete source file selection.</summary>
          [Microsoft.Build.Framework.Required]
          public Microsoft.Build.Framework.ITaskItem[] SourceFiles
          {
            get => m_copy.SourceFiles;
            set => m_copy.SourceFiles = value;
          }

          /// <summary>Gets or sets the corresponding private destination files.</summary>
          [Microsoft.Build.Framework.Required]
          public Microsoft.Build.Framework.ITaskItem[] DestinationFiles
          {
            get => m_copy.DestinationFiles;
            set => m_copy.DestinationFiles = value;
          }

          /// <summary>Gets or sets whether the SDK may create hardlinks.</summary>
          public bool UseHardlinksIfPossible
          {
            get => m_copy.UseHardlinksIfPossible;
            set => m_copy.UseHardlinksIfPossible = value;
          }

          /// <summary>Gets or sets whether the SDK may retain unchanged destination files.</summary>
          public bool SkipUnchangedFiles
          {
            get => m_copy.SkipUnchangedFiles;
            set => m_copy.SkipUnchangedFiles = value;
          }

          /// <summary>Delegates materialization to the selected SDK implementation.</summary>
          /// <returns>True after successful copying; false after failure or cancellation.</returns>
          public override bool Execute()
          {
            m_copy.BuildEngine = BuildEngine;
            return m_copy.Execute();
          }

          /// <summary>Cancels the same SDK operation used for materialization.</summary>
          public void Cancel() => m_copy.Cancel();
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- This adapter uses the normally built Foundation assembly before private SDK outputs exist. -->
  <UsingTask
    TaskName="Inno.Build.TaskHosting.TaskRuntimeBootstrapOwner"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)../tasks/Inno.Build.TaskHosting/TaskRuntimeBootstrapOwner.cs" />
    </Task>
  </UsingTask>

  <Target Name="BindInnoTaskLoadIdentity" Condition="'$(DesignTimeBuild)' != 'true'">
    <InnoTaskRuntimeLoadIdentity>
      <Output TaskParameter="Identity" PropertyName="InnoTaskLoadId" />
    </InnoTaskRuntimeLoadIdentity>
    <PropertyGroup>
      <InnoTaskLoadDirectory>$(InnoTaskArtifacts)/loads/$(InnoTaskLoadId)/$(Configuration)</InnoTaskLoadDirectory>
      <InnoTaskHostAssembly>$(InnoTaskLoadDirectory)/Inno.Build.Tasks.dll</InnoTaskHostAssembly>
      <InnoTaskPublisherDirectory>$(InnoTaskArtifacts)/publishers/$(InnoTaskLoadId)/$(Configuration)</InnoTaskPublisherDirectory>
      <InnoTaskPublisherAssembly>$(InnoTaskPublisherDirectory)/Inno.Build.TaskHosting.dll</InnoTaskPublisherAssembly>
    </PropertyGroup>
  </Target>

  <Target
    Name="PrepareInnoTaskPublisher"
    DependsOnTargets="BindInnoTaskLoadIdentity"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_InnoFoundationExcludedProperties>$([System.String]::Copy('$(InnoTaskExcludedProperties)').Replace(';InnoTaskBootstrapOwner', ''))</_InnoFoundationExcludedProperties>
    </PropertyGroup>
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)../../src/foundation/core/Inno.Core.IO/Inno.Core.IO.csproj"
      Targets="Restore;Build"
      Properties="$(InnoTaskHostProperties);InnoTaskBootstrapOwner=$(InnoTaskBootstrapOwner)"
      RemoveProperties="$(_InnoFoundationExcludedProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_InnoFoundationOutput" />
    </MSBuild>
    <Error Condition="'@(_InnoFoundationOutput->Count())' != '1'" Text="Foundation bootstrap must return one SDK-selected assembly." />
    <Inno.Build.TaskHosting.TaskRuntimeBootstrapOwner
      Root="$([System.IO.Path]::GetFullPath('$(InnoTaskArtifacts)/publishers'))"
      Identity="$(InnoTaskBootstrapOwner)"
      FoundationAssembly="@(_InnoFoundationOutput)">
      <Output TaskParameter="Directory" PropertyName="_InnoClaimedBootstrap" />
    </Inno.Build.TaskHosting.TaskRuntimeBootstrapOwner>
    <PropertyGroup>
      <InnoTaskBootstrapDirectory>$(_InnoClaimedBootstrap)/$(Configuration)</InnoTaskBootstrapDirectory>
    </PropertyGroup>
    <Error
      Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(InnoTaskBootstrapOwner)', '^[a-f0-9]{32}$'))"
      Text="Task bootstrap ownership requires one generated operation identity." />
    <MSBuild
      Projects="$(InnoTaskPublisherProject)"
      Targets="Restore;PublishInnoTaskPublisherBootstrap"
      Properties="$(InnoTaskHostProperties);ArtifactsPath=$(InnoTaskBootstrapDirectory)/bootstrap;InnoTaskBootstrapOwner=$(InnoTaskBootstrapOwner)"
      RemoveProperties="$(InnoTaskExcludedProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_InnoPublisherOutput" />
    </MSBuild>
    <Error Condition="'@(_InnoPublisherOutput->Count())' != '1'" Text="The task publisher must return one bootstrap assembly." />
    <PropertyGroup>
      <_InnoPublisherSource>@(_InnoPublisherOutput)</_InnoPublisherSource>
      <_InnoPublisherSourceDirectory>$([System.IO.Path]::GetDirectoryName('$(_InnoPublisherSource)'))</_InnoPublisherSourceDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_InnoPublisherFile Include="$(_InnoPublisherSourceDirectory)/**/*" Exclude="$(_InnoPublisherSourceDirectory)/**/*.pdb;$(_InnoPublisherSourceDirectory)/**/*.xml" />
    </ItemGroup>
    <InnoMaterializePrivateRuntime
      SourceFiles="@(_InnoPublisherFile)"
      DestinationFiles="@(_InnoPublisherFile->'$(InnoTaskPublisherDirectory)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Error Condition="!Exists('$(InnoTaskPublisherAssembly)')" Text="The private task publisher was not copied to its registered load path: $(InnoTaskPublisherAssembly)" />
    <Inno.Build.TaskHosting.RegisterTaskPublisherTask
      PublisherRoot="$([System.IO.Path]::GetFullPath('$(InnoTaskArtifacts)/publishers'))"
      BootstrapDirectory="$([System.IO.Path]::GetFullPath('$(InnoTaskBootstrapDirectory)'))"
      PublisherDirectory="$([System.IO.Path]::GetFullPath('$(InnoTaskPublisherDirectory)'))" />
  </Target>

  <Target
    Name="PublishInnoTaskPublisherBootstrap"
    DependsOnTargets="Build"
    Returns="$(TargetPath)"
    Condition="'$(MSBuildProjectName)' == 'Inno.Build.TaskHosting'" />

  <Target Name="PrepareInnoBuildTaskHost" DependsOnTargets="PrepareInnoTaskPublisher" Condition="'$(DesignTimeBuild)' != 'true'">
    <Inno.Build.TaskHosting.BuildTaskRuntimeTask
      ProjectFile="$([System.IO.Path]::GetFullPath('$(InnoTaskProject)'))"
      ArtifactsDirectory="$([System.IO.Path]::GetFullPath('$(InnoTaskArtifacts)/workspaces/shared'))"
      LoadDirectory="$([System.IO.Path]::GetFullPath('$(InnoTaskLoadDirectory)'))"
      Targets="Restore;PublishInnoBuildTaskHost"
      Properties="$(InnoTaskHostProperties);InnoTaskBootstrapOwner=$(InnoTaskBootstrapOwner)"
      RemoveProperties="$(InnoTaskExcludedProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_InnoTaskHostOutput" />
    </Inno.Build.TaskHosting.BuildTaskRuntimeTask>
    <Error Condition="'@(_InnoTaskHostOutput)' == ''" Text="The build task host must return its complete hashed runtime closure." />
    <Inno.Build.TaskHosting.PublishTaskHostTask
      InputFiles="@(_InnoTaskHostOutput)"
      CacheDirectory="$(InnoTaskArtifacts)/hosts"
      LoadDirectory="$(InnoTaskLoadDirectory)"
      PublisherDirectory="$(InnoTaskPublisherDirectory)">
      <Output TaskParameter="PublishedAssembly" PropertyName="_InnoPreparedTaskAssembly" />
    </Inno.Build.TaskHosting.PublishTaskHostTask>
    <PropertyGroup>
      <_InnoPreparedTaskDirectory>$([System.IO.Path]::GetDirectoryName('$(_InnoPreparedTaskAssembly)'))</_InnoPreparedTaskDirectory>
    </PropertyGroup>
    <Error Condition="'$(_InnoPreparedTaskDirectory)' == '' or !Exists('$(_InnoPreparedTaskAssembly)')" Text="The build task snapshot is unavailable: $(_InnoPreparedTaskAssembly)" />
    <ItemGroup>
      <_InnoPreparedRuntimeFile Include="$(_InnoPreparedTaskDirectory)/**/*" />
    </ItemGroup>
    <InnoMaterializePrivateRuntime
      SourceFiles="@(_InnoPreparedRuntimeFile)"
      DestinationFiles="@(_InnoPreparedRuntimeFile->'$(InnoTaskLoadDirectory)/%(RecursiveDir)%(Filename)%(Extension)')"
      UseHardlinksIfPossible="true"
      SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(InnoTaskLoadDirectory)/source-host.txt" Lines="$(_InnoPreparedTaskAssembly)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- The lightweight publisher snapshots this closure before consumers load a private runtime. -->
  <Target
    Name="PublishInnoBuildTaskHost"
    DependsOnTargets="Build"
    Returns="@(_InnoHashedTaskInput)"
    Condition="'$(MSBuildProjectName)' == 'Inno.Build.Tasks'">
    <ItemGroup>
      <_InnoTaskRuntimeInput Include="$(TargetDir)**/*" Exclude="$(TargetDir)**/*.pdb;$(TargetDir)**/*.xml" />
    </ItemGroup>
    <ItemGroup>
      <_InnoTaskRuntimeInput>
        <RelativePath>%(_InnoTaskRuntimeInput.RecursiveDir)%(_InnoTaskRuntimeInput.Filename)%(_InnoTaskRuntimeInput.Extension)</RelativePath>
      </_InnoTaskRuntimeInput>
    </ItemGroup>
    <Error Condition="!Exists('$(TargetPath)')" Text="The build task assembly was not produced." />
    <GetFileHash Files="@(_InnoTaskRuntimeInput)">
      <Output TaskParameter="Items" ItemName="_InnoHashedTaskInput" />
    </GetFileHash>
  </Target>
</Project>
