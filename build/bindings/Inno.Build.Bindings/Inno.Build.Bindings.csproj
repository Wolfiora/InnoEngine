<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <ProjectReference Include="../../../src/foundation/core/Inno.Core.IO/Inno.Core.IO.csproj" PrivateAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BGCS" Version="[$(InnoBgcsPackageVersion)]" />
  </ItemGroup>

  <Target Name="ComputeBindingImplementationIdentity" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/**/*.cs" Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/Inno.Build.Bindings.csproj" />
      <_BindingImplementationInput Include="$(RoslynTargetsPath)/bincore/csc.dll" />
      <_BindingImplementationInput Include="$(RoslynTargetsPath)/bincore/Microsoft.CodeAnalysis.dll" />
      <_BindingImplementationInput Include="$(RoslynTargetsPath)/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBindingCompilation.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBindingSourceRoot.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBindingSourceFile.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBindingIncludeDirectory.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildFingerprint.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildInput.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputSnapshot.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputReadCache.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildInputState.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputVerificationScope.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/BuildArtifactManifest.cs" />
      <_BindingImplementationInput Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'BGCS' or $([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('BGCS.'))" />
      <_BindingImplementationInput Include="@(NativeCopyLocalItems)" />
      <_BindingImplementationInput Include="$(NuGetPackageRoot)bgcs/$(InnoBgcsPackageVersion)/bgcs.$(InnoBgcsPackageVersion).nupkg.sha512;$(NuGetPackageRoot)bgcs.core/$(InnoBgcsPackageVersion)/bgcs.core.$(InnoBgcsPackageVersion).nupkg.sha512" />
    </ItemGroup>
    <GetFileHash Files="@(_BindingImplementationInput)">
      <Output TaskParameter="Items" ItemName="_BindingImplementationHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)binding-implementation.inputs"
                      Lines="@(_BindingImplementationHash-&gt;'%(Filename)%(Extension)|%(FileHash)');sdk=$(NETCoreSdkVersion);framework=$(TargetFramework);language=$(LangVersion);defines=$(DefineConstants);nullable=$(Nullable);checked=$(CheckForOverflowUnderflow);unsafe=$(AllowUnsafeBlocks);optimize=$(Optimize);features=$(Features)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <GetFileHash Files="$(IntermediateOutputPath)binding-implementation.inputs">
      <Output TaskParameter="Hash" PropertyName="_BindingImplementationFingerprint" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyMetadata Include="Inno.BindingImplementation" Value="$(_BindingImplementationFingerprint)" />
      <AssemblyMetadata Include="Inno.BindingPackageVersion" Value="$(InnoBgcsPackageVersion)" />
    </ItemGroup>
  </Target>
</Project>
