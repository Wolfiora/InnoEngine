<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <ProjectReference Include="../../../src/foundation/core/Inno.Core.IO/Inno.Core.IO.csproj" PrivateAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BGCS" Version="[$(InnoBgcsPackageVersion)]" PrivateAssets="compile" />
    <PackageReference Include="BGCS.Cpp2C" Version="[$(InnoBgcsPackageVersion)]" PrivateAssets="compile" />
    <PackageReference Include="BGCS.Core" Version="[$(InnoBgcsPackageVersion)]" PrivateAssets="compile" />
    <PackageReference Include="BGCS.CppAst" Version="[$(InnoBgcsPackageVersion)]" PrivateAssets="compile" />
    <PackageReference Include="BGCS.Intermediate" Version="[$(InnoBgcsPackageVersion)]" PrivateAssets="compile" />
    <PackageReference Include="BGCS.Language" Version="[$(InnoBgcsPackageVersion)]" PrivateAssets="compile" />
  </ItemGroup>

  <Target Name="ComputeBindingImplementationIdentity" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/**/*.cs" Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/NativeBindingGenerator.Inputs.cs;$(MSBuildProjectDirectory)/Identity/BindingInputPlanning.cs" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/Inno.Build.Bindings.csproj" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildFingerprint.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildInput.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputSnapshot.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputReadCache.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildInputState.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputVerificationScope.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/BuildArtifactManifest.cs" />
      <_BindingImplementationInput Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'BGCS' or $([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('BGCS.'))" />
      <_BindingImplementationInput Include="@(NativeCopyLocalItems)" />
      <_BindingImplementationInput Include="$(NuGetPackageRoot)bgcs/$(InnoBgcsPackageVersion)/bgcs.$(InnoBgcsPackageVersion).nupkg.sha512;$(NuGetPackageRoot)bgcs.core/$(InnoBgcsPackageVersion)/bgcs.core.$(InnoBgcsPackageVersion).nupkg.sha512;$(NuGetPackageRoot)bgcs.cpp2c/$(InnoBgcsPackageVersion)/bgcs.cpp2c.$(InnoBgcsPackageVersion).nupkg.sha512;$(NuGetPackageRoot)bgcs.cppast/$(InnoBgcsPackageVersion)/bgcs.cppast.$(InnoBgcsPackageVersion).nupkg.sha512;$(NuGetPackageRoot)bgcs.intermediate/$(InnoBgcsPackageVersion)/bgcs.intermediate.$(InnoBgcsPackageVersion).nupkg.sha512;$(NuGetPackageRoot)bgcs.language/$(InnoBgcsPackageVersion)/bgcs.language.$(InnoBgcsPackageVersion).nupkg.sha512" />
    </ItemGroup>
    <GetFileHash Files="@(_BindingImplementationInput)">
      <Output TaskParameter="Items" ItemName="_BindingImplementationHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)binding-implementation.inputs" Lines="@(_BindingImplementationHash-&gt;'%(Filename)%(Extension)|%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <GetFileHash Files="$(IntermediateOutputPath)binding-implementation.inputs">
      <Output TaskParameter="Hash" PropertyName="_BindingImplementationFingerprint" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyMetadata Include="Inno.BindingImplementation" Value="$(_BindingImplementationFingerprint)" />
      <AssemblyMetadata Include="Inno.BindingPackageVersion" Value="$(InnoBgcsPackageVersion)" />
    </ItemGroup>
  </Target>
</Project>
