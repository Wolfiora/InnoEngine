<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BindGenRoot Condition="'$(BindGenRoot)' == ''">$(MSBuildProjectDirectory)/../../../../BindGen-CS</BindGenRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <ProjectReference Include="../../../src/foundation/core/Inno.Core.IO/Inno.Core.IO.csproj" PrivateAssets="compile" />
    <ProjectReference Include="$(BindGenRoot)/src/BGCS/BGCS.csproj" PrivateAssets="compile" />
    <ProjectReference Include="$(BindGenRoot)/src/BGCS.Cpp2C/BGCS.Cpp2C.csproj" PrivateAssets="compile" />
  </ItemGroup>

  <Target Name="ComputeBindingImplementationIdentity" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/**/*.cs" Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/Inno.Build.Bindings.csproj" />
      <_BindingImplementationInput Include="$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildFingerprint.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildInput.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputSnapshot.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputReadCache.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeBuildInputState.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/Native/NativeInputVerificationScope.cs;$(MSBuildProjectDirectory)/../../toolchains/Inno.Build.Toolchains/BuildArtifactManifest.cs" />
    </ItemGroup>
    <GetFileHash Files="@(_BindingImplementationInput)">
      <Output TaskParameter="Items" ItemName="_BindingImplementationHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)binding-implementation.inputs" Lines="@(_BindingImplementationHash-&gt;'%(Filename)%(Extension)|%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <GetFileHash Files="$(IntermediateOutputPath)binding-implementation.inputs">
      <Output TaskParameter="Hash" PropertyName="_BindingImplementationFingerprint" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyMetadata Include="Inno.BindingImplementation" Value="$(_BindingImplementationFingerprint)" />
    </ItemGroup>
  </Target>
</Project>
