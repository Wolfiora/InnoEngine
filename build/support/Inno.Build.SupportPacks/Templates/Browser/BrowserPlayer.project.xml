<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <AssemblyName>Inno.Player.Browser</AssemblyName>
    <InnoGeneratePlayerComposition>true</InnoGeneratePlayerComposition>
    <EmccFlags>-sSUPPORT_LONGJMP=wasm -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1</EmccFlags>
  </PropertyGroup>
  <ItemGroup>
    <_EngineAssembly Include="References/*.dll" />
    <_GameAssembly Include="$(InnoGameManagedRoot)/*.dll" />
    <Reference Include="@(_EngineAssembly);@(_GameAssembly)" />
    <NativeFileReference Include="Native/*.a;Native/*.c" />
    <Analyzer Include="Analyzers/*.dll" />
    <CompilerVisibleProperty Include="InnoGeneratePlayerComposition" />
    <AssemblyMetadata Include="Inno.AssemblyDomain" Value="InnoInternal" />
    <AssemblyMetadata Include="Inno.AssemblyScope" Value="Runtime" />
  </ItemGroup>
  <Target Name="ValidateGameCodeComposition" BeforeTargets="ResolveReferences">
    <Error Condition="'$(InnoGameManagedRoot)' == '' or '@(_GameAssembly)' == '' or !Exists('PlayerDeploymentDefinition.g.cs')"
           Text="Player publication requires a frozen code closure and its generated deployment composition." />
  </Target>
</Project>
