# Keep authored MSBuild files consistent on every checkout host.
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Preserve the SDK's exact native payload bytes and their recorded integrity hashes.
backends/**/native/**/Native/Generated/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve official font license bytes and upstream formatting on every host.
assets/fonts/LICENSE-JetBrainsMono.txt -text -whitespace
assets/fonts/icons/LICENSE-FontAwesome.txt -text -whitespace
