    <ProjectReference Include="../../src/composition/editor/framework/Inno.Editor.Core/Inno.Editor.Core.csproj" />
    <ProjectReference Include="../../src/composition/editor/framework/Inno.Editor.Interactions/Inno.Editor.Interactions.csproj" />
    <ProjectReference Include="../../src/composition/editor/framework/Inno.Editor.Graph/Inno.Editor.Graph.csproj" />
    <ProjectReference Include="../../src/composition/editor/framework/Inno.Editor.Inspection/Inno.Editor.Inspection.csproj" />
    <ProjectReference Include="../../src/foundation/core/Inno.Core.Logging/Inno.Core.Logging.csproj" />
    <ProjectReference Include="../../src/foundation/core/Inno.Core.Diagnostics/Inno.Core.Diagnostics.csproj" />
