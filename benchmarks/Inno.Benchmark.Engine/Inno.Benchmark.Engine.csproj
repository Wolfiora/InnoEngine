  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tests/foundation/extensibility/fixtures/Inno.Extensibility.Modules.TestModule.V1/Inno.Extensibility.Modules.TestModule.V1.csproj" ReferenceOutputAssembly="false" OutputItemType="BenchmarkModuleV1" PrivateAssets="compile" />
    <ProjectReference Include="../../tests/foundation/extensibility/fixtures/Inno.Extensibility.Modules.TestModule.V2/Inno.Extensibility.Modules.TestModule.V2.csproj" ReferenceOutputAssembly="false" OutputItemType="BenchmarkModuleV2" PrivateAssets="compile" />
    <ProjectReference Include="../../tests/foundation/extensibility/fixtures/Inno.Extensibility.Modules.TestDependency/Inno.Extensibility.Modules.TestDependency.csproj" ReferenceOutputAssembly="false" OutputItemType="BenchmarkModuleDependency" PrivateAssets="compile" />
  </ItemGroup>

  <Target Name="CopyBenchmarkReloadModules" AfterTargets="Build">
    <Copy SourceFiles="@(BenchmarkModuleV1)" DestinationFolder="$(OutDir)Modules/V1" />
    <Copy SourceFiles="@(BenchmarkModuleV2)" DestinationFolder="$(OutDir)Modules/V2" />
    <Copy SourceFiles="@(BenchmarkModuleDependency)" DestinationFolder="$(OutDir)Modules/V1" />
    <Copy SourceFiles="@(BenchmarkModuleDependency)" DestinationFolder="$(OutDir)Modules/V2" />
  </Target>
</Project>
