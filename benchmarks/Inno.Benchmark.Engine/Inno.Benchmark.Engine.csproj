    <ProjectReference Include="../../src/foundation/core/Inno.Core.Serialization/Inno.Core.Serialization.csproj" />
    <ProjectReference Include="../../src/foundation/extensibility/Inno.Extensibility.Types/Inno.Extensibility.Types.csproj" />
    <ProjectReference Include="../../src/foundation/extensibility/Inno.Extensibility.Modules/Inno.Extensibility.Modules.csproj" />
    <ProjectReference Include="../../src/services/input/Inno.Input/Inno.Input.csproj" />
    <ProjectReference Include="../../src/adapters/input/Inno.Adapter.Input/Inno.Adapter.Input.csproj" />
    <ProjectReference Include="../../src/services/rendering/Inno.Rendering/Inno.Rendering.csproj" />
    <ProjectReference Include="../../src/content/assets/Inno.Assets/Inno.Assets.csproj" />
    <ProjectReference Include="../../src/content/scene/Inno.Scene/Inno.Scene.csproj" />
    <ProjectReference Include="../../backends/DotNet/runtime/Inno.Adapter.Modules.DotNet/Inno.Adapter.Modules.DotNet.csproj" />
    <ProjectReference Include="../../backends/DotNet/runtime/Inno.Adapter.Serialization.DotNet/Inno.Adapter.Serialization.DotNet.csproj" />
    <ProjectReference Include="../../src/content/deployment/Inno.Content/Inno.Content.csproj" />
    <ProjectReference Include="../../src/runtime/engine/Inno.Runtime/Inno.Runtime.csproj" />
    <ProjectReference Include="../../src/content/assets/Inno.Assets.Pipeline/Inno.Assets.Pipeline.csproj" />
    <ProjectReference Include="../../src/services/rendering/Inno.Rendering.Shaders/Inno.Rendering.Shaders.csproj" />
    <ProjectReference Include="../../src/services/rendering/Inno.Rendering.Assets.Authoring/Inno.Rendering.Assets.Authoring.csproj" />
