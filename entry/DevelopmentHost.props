<Project>
  <!-- Resolve the SDK execution host without changing any game publication target. -->
  <Import Project="../build/distributions/Inno.Build.Distribution.Standard/StandardDevelopmentProducts.props" />

  <Target
    Name="ValidateDevelopmentHost"
    BeforeTargets="PrepareForBuild"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <Error
      Condition="'$(InnoDevelopmentTarget)' == ''"
      Text="InnoEngine development requires a Windows X64 or macOS Arm64 .NET SDK. Current SDK host: $(NETCoreSdkRuntimeIdentifier)." />
  </Target>
</Project>
