<Project
  Sdk="Microsoft.NET.Sdk"
  TreatAsLocalProperty="BuildProjectReferences;BuildingInsideVisualStudio;OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration">
  <Import Project="../DevelopmentHost.props" />

  <PropertyGroup>
    <!-- Direct and product references must share one restore/output context. -->
    <InnoNativeTarget Condition="'$(InnoNativeTarget)' == ''">$(InnoDevelopmentTarget)</InnoNativeTarget>
    <InnoToolTarget Condition="'$(InnoToolTarget)' == ''">$(InnoDevelopmentTarget)</InnoToolTarget>
    <InnoProductBuildProperties Condition="'$(InnoProductBuildProperties)' == ''">$(InnoDevelopmentEditorBuildProperties)</InnoProductBuildProperties>
    <InnoProductRestoreProject>$(InnoDevelopmentEditorProject)</InnoProductRestoreProject>
    <OutputType>Exe</OutputType>
    <AssemblyName>InnoEngine.Editor</AssemblyName>
    <RootNamespace>InnoEngine.Editor</RootNamespace>
    <ApplicationIcon>../../build/branding/logo.ico</ApplicationIcon>
    <!-- The host product is built through this reference, rather than as a second solution root. -->
    <OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration>false</OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration>
    <BuildProjectReferences Condition="'$(DesignTimeBuild)' != 'true'">true</BuildProjectReferences>
    <BuildingInsideVisualStudio Condition="'$(DesignTimeBuild)' != 'true'">false</BuildingInsideVisualStudio>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(InnoDevelopmentEditorProject)"
      Condition="'$(InnoDevelopmentEditorProject)' != ''"
      PrivateAssets="compile" />
    <ProjectReference Include="../../src/foundation/core/Inno.Core.IO/Inno.Core.IO.csproj" PrivateAssets="compile" />
  </ItemGroup>

  <ItemDefinitionGroup Condition="'$(DesignTimeBuild)' != 'true'">
    <ProjectReference>
      <AdditionalProperties>BuildProjectReferences=true;BuildingInsideVisualStudio=false</AdditionalProperties>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <AssemblyMetadata
      Include="Inno.Editor.ProductLock"
      Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/products/editor/$(InnoDevelopmentTarget)/$(Configuration)/product.lock'))" />
  </ItemGroup>

  <Target
    Name="CreateMacOSEditorApplicationBundle"
    AfterTargets="Publish"
    Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx-')))">
    <PropertyGroup>
      <_InnoEditorPublishRoot>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_InnoEditorPublishRoot>
      <_InnoEditorAppBundle>$(_InnoEditorPublishRoot)../$(AssemblyName).app</_InnoEditorAppBundle>
      <_InnoEditorContents>$(_InnoEditorAppBundle)/Contents</_InnoEditorContents>
      <_InnoEditorMacOS>$(_InnoEditorContents)/MacOS</_InnoEditorMacOS>
      <_InnoEditorResources>$(_InnoEditorContents)/Resources</_InnoEditorResources>
      <_InnoEditorIcon>$(MSBuildThisFileDirectory)../../build/branding/logo.icns</_InnoEditorIcon>
      <_InnoEditorInfoPlist>$(MSBuildThisFileDirectory)MacOS/Info.plist</_InnoEditorInfoPlist>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(_InnoEditorPublishRoot)$(AssemblyName)')"
      Text="macOS publish output does not contain the '$(AssemblyName)' apphost." />
    <Error
      Condition="!Exists('$(_InnoEditorIcon)')"
      Text="The macOS application icon is absent: '$(_InnoEditorIcon)'." />
    <Error
      Condition="!Exists('$(_InnoEditorInfoPlist)')"
      Text="The macOS Info.plist template is absent: '$(_InnoEditorInfoPlist)'." />
    <RemoveDir Directories="$(_InnoEditorAppBundle)" />
    <MakeDir Directories="$(_InnoEditorMacOS);$(_InnoEditorResources)" />
    <Exec Command="ditto &quot;$(_InnoEditorPublishRoot)&quot; &quot;$(_InnoEditorMacOS)&quot;" />
    <Copy SourceFiles="$(_InnoEditorIcon)" DestinationFolder="$(_InnoEditorResources)" />
    <Copy SourceFiles="$(_InnoEditorInfoPlist)" DestinationFiles="$(_InnoEditorContents)/Info.plist" />
    <Exec Command="chmod +x &quot;$(_InnoEditorMacOS)/$(AssemblyName)&quot;" />
    <Message Importance="high" Text="Created macOS application bundle '$(_InnoEditorAppBundle)'." />
  </Target>
</Project>
