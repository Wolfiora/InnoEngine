root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
# Method and lambda bodies keep the opening brace with the closing parameter list.
csharp_new_line_before_open_brace = types, properties, accessors, anonymous_types, control_blocks, object_collection_array_initializers
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.CS1572.severity = warning
dotnet_diagnostic.CS1573.severity = warning
dotnet_diagnostic.CS1591.severity = warning
dotnet_diagnostic.IDE0005.severity = warning

dotnet_naming_rule.properties_are_camel_case.symbols = properties
dotnet_naming_rule.properties_are_camel_case.style = camel_case
dotnet_naming_rule.properties_are_camel_case.severity = warning
dotnet_naming_symbols.properties.applicable_kinds = property
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_rule.private_fields_have_owner_prefix.symbols = private_fields
dotnet_naming_rule.private_fields_have_owner_prefix.style = owner_field
dotnet_naming_rule.private_fields_have_owner_prefix.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.owner_field.required_prefix = m_
dotnet_naming_style.owner_field.capitalization = camel_case

# More specific modifier rules take precedence over the private-field rule.
dotnet_naming_rule.constants_have_constant_prefix.symbols = constants
dotnet_naming_rule.constants_have_constant_prefix.style = constant_name
dotnet_naming_rule.constants_have_constant_prefix.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.constant_name.required_prefix = C_
dotnet_naming_style.constant_name.capitalization = all_upper

dotnet_naming_rule.static_readonly_fields_have_semantic_names.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_have_semantic_names.style = pascal_case
dotnet_naming_rule.static_readonly_fields_have_semantic_names.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.types_are_pascal_case.symbols = types
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

[**/Generated/*.cs]
generated_code = true

[**/extern/**]
generated_code = true
