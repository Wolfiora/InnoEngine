<Project>
  <Import Project="$(InnoProductBuildProperties)" Condition="'$(InnoProductBuildProperties)' != ''" />
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <!-- Preserve all global properties without placing IDE-sized values on the command line. -->
    <RestoreSerializeGlobalProperties>true</RestoreSerializeGlobalProperties>
    <PathMap>$(PathMap);$(MSBuildThisFileDirectory)=/_/InnoEngine/</PathMap>
  </PropertyGroup>
  <Import Project="$(InnoNativeBindingSelection)" Condition="'$(InnoNativeBindingSelection)' != '' and Exists('$(InnoNativeBindingSelection)')" />
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InnoNativeTarget)' != ''">
    <BaseIntermediateOutputPath>obj/$(InnoNativeTarget)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(InnoNativeTarget)/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InnoNativeTarget)' != '' and '$(InnoNativeBuildFingerprint)' != ''">
    <BaseIntermediateOutputPath>obj/$(InnoNativeTarget)/$(InnoNativeBuildFingerprint)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(InnoNativeTarget)/$(InnoNativeBuildFingerprint)/</BaseOutputPath>
  </PropertyGroup>
</Project>
