if(NOT INNO_LIBRARY_KIND STREQUAL "STATIC")
    message(FATAL_ERROR "This archive recipe requires explicit static linkage")
endif()
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
add_subdirectory("${INNO_ROOT}/extern/SDL" sdl)
install(TARGETS SDL3-static ARCHIVE COMPONENT Inno DESTINATION "${INNO_COMPONENT_ID}/${INNO_NATIVE_TARGET}")
