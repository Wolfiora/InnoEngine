<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BGCS" Version="[$(InnoBgcsPackageVersion)]" />
    <PackageReference Include="BGCS.Core" Version="[$(InnoBgcsPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Managed/ImTextureID.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Managed/ImVector.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
