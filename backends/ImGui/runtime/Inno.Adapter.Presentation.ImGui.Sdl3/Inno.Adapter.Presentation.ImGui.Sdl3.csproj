<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Sdl3/native/Inno.Native.Sdl3/Inno.Native.Sdl3.csproj" />
    <ProjectReference Include="../../native/Inno.Native.ImGui/Inno.Native.ImGui.csproj" />
    <ProjectReference Include="$(BGCSRuntimeProject)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/adapters/platform/Inno.Adapter.Platform/Inno.Adapter.Platform.csproj" />
    <ProjectReference Include="../../../../src/adapters/presentation/Inno.Adapter.Presentation/Inno.Adapter.Presentation.csproj" />
    <ProjectReference Include="../../../../src/services/platform/Inno.Platform/Inno.Platform.csproj" />
    <ProjectReference Include="../../../Sdl3/runtime/Inno.Adapter.Platform.Sdl3/Inno.Adapter.Platform.Sdl3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="BuiltIn/**/*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="BuiltIn/Icons/FA-Regular-400.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="BuiltIn/Icons/FA-Solid-900.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/foundation/extensibility/Inno.Extensibility.Catalogs/Inno.Extensibility.Catalogs.csproj" />
  </ItemGroup>
</Project>
