<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1572;CS1573;CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../native/Inno.Native.ImGui/Inno.Native.ImGui.csproj" PrivateAssets="compile" />
    <ProjectReference
      Include="../../rendering/Inno.Adapter.Rendering.Bgfx/Inno.Adapter.Rendering.Bgfx.csproj"
      PrivateAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Inno.Adapter.Presentation/Inno.Adapter.Presentation.csproj" />
    <ProjectReference Include="../Inno.Adapter.Presentation.ImGui.Sdl3/Inno.Adapter.Presentation.ImGui.Sdl3.csproj" />
    <ProjectReference Include="../../../services/rendering/Inno.Rendering/Inno.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_ImGuiShaderSource Include="Shaders/**/*" />
    <_ImGuiShaderApi Include="Metal;Vulkan;OpenGL" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <_ImGuiShaderApi Include="Direct3D11;Direct3D12;Vulkan;OpenGL" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <PropertyGroup>
    <_ImGuiShaderPlatform Condition="$([MSBuild]::IsOSPlatform('OSX'))">MacOSArm64</_ImGuiShaderPlatform>
    <_ImGuiShaderPlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">WindowsX64</_ImGuiShaderPlatform>
  </PropertyGroup>

  <Target Name="CollectImGuiShaderCompilerInputs" DependsOnTargets="PrepareInnoBuildTaskHost">
    <ItemGroup>
      <_ImGuiShaderCompilerInput Include="$([System.IO.Path]::GetDirectoryName('$(InnoTaskHostAssembly)'))/*.dll" />
      <_ImGuiShaderCompilerInput Include="../../../../extern/bgfx/src/*.sh;../../../../extern/bgfx/tools/bin/**/*" />
    </ItemGroup>
  </Target>

  <Target
    Name="CompileImGuiShaderGraphs"
    DependsOnTargets="CollectImGuiShaderCompilerInputs"
    Inputs="@(_ImGuiShaderSource);@(_ImGuiShaderCompilerInput);$(InnoTaskHostAssembly);$(MSBuildProjectFullPath)"
    Outputs="@(_ImGuiShaderApi-&gt;'$(IntermediateOutputPath)Shaders/%(Identity).bin')">
    <Error
      Condition="'$(_ImGuiShaderPlatform)' == ''"
      Text="No built-in ImGui shader distribution target exists for this host." />
    <CompileShaderTask
      EngineRoot="$(MSBuildProjectDirectory)/../../../.."
      Configuration="$(Configuration)"
      AssetRoot="$(MSBuildProjectDirectory)/Shaders"
      ShaderPath="ImGui.ishader"
      Platform="$(_ImGuiShaderPlatform)"
      Renderer="%(_ImGuiShaderApi.Identity)"
      OutputFile="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Shaders/%(_ImGuiShaderApi.Identity).bin" />
  </Target>

  <Target
    Name="IncludeImGuiShaderArtifacts"
    Condition="'$(DesignTimeBuild)' != 'true'"
    BeforeTargets="AssignTargetPaths"
    DependsOnTargets="CompileImGuiShaderGraphs">
    <ItemGroup>
      <EmbeddedResource Include="@(_ImGuiShaderApi-&gt;'$(IntermediateOutputPath)Shaders/%(Identity).bin')">
        <LogicalName>Inno.BuiltInShaders.ImGui.$(_ImGuiShaderPlatform).%(Filename)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="../../../foundation/extensibility/Inno.Extensibility.Catalogs/Inno.Extensibility.Catalogs.csproj" />
  </ItemGroup>

</Project>
