vec3 LinearToSrgb(vec3 color)
{
    vec3 positive = max(color, vec3(0.0, 0.0, 0.0));
    vec3 lower = positive * 12.92;
    vec3 upper = 1.055 * pow(positive, vec3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) - 0.055;
    return mix(upper, lower, step(positive, vec3(0.0031308, 0.0031308, 0.0031308)));
}

vec4 Evaluate(
    sampler2D image,
    vec2 texcoord,
    vec4 tint
) {
    vec4 color = texture2D(image, texcoord) * tint;
    vec3 straight = color.a > 0.0 ? color.rgb / color.a : vec3(0.0, 0.0, 0.0);
    return vec4(LinearToSrgb(straight) * color.a, color.a);
}
