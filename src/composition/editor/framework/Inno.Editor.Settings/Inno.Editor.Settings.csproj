  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../foundation/core/Inno.Core.Serialization/Inno.Core.Serialization.csproj" />
    <ProjectReference Include="../../../../foundation/core/Inno.Core.Settings/Inno.Core.Settings.csproj" />
