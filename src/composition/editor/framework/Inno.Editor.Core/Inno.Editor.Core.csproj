      Include="../../../../foundation/core/Inno.Core.Execution/Inno.Core.Execution.csproj"
      PrivateAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../foundation/extensibility/Inno.Extensibility.Modules/Inno.Extensibility.Modules.csproj" />
    <ProjectReference Include="../../../../runtime/scripting/Inno.Scripting.Reload/Inno.Scripting.Reload.csproj" />
