  <ItemGroup>
    <ProjectReference Include="../../../../runtime/contracts/Inno.Runtime.Contracts/Inno.Runtime.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../foundation/extensibility/Inno.Extensibility.Reload/Inno.Extensibility.Reload.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <InnoEditorPublishRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</InnoEditorPublishRuntimeIdentifier>
    <InnoEditorPublishRuntimeIdentifier Condition="'$(InnoEditorPublishRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</InnoEditorPublishRuntimeIdentifier>
    <InnoEditorPublishSupportPackTarget Condition="'$(InnoEditorPublishRuntimeIdentifier)' == 'osx-arm64'">macos-arm64</InnoEditorPublishSupportPackTarget>
    <InnoEditorPublishSupportPackTarget Condition="'$(InnoEditorPublishRuntimeIdentifier)' == 'win-x64'">windows-x64</InnoEditorPublishSupportPackTarget>
    <InnoEditorPublishNativePlatform Condition="'$(InnoEditorPublishSupportPackTarget)' == 'macos-arm64'">osx-arm64</InnoEditorPublishNativePlatform>
    <InnoEditorPublishNativePlatform Condition="'$(InnoEditorPublishSupportPackTarget)' == 'windows-x64'">windows-x64</InnoEditorPublishNativePlatform>
    <InnoEditorPublishNativeExtension Condition="'$(InnoEditorPublishSupportPackTarget)' == 'macos-arm64'">.dylib</InnoEditorPublishNativeExtension>
    <InnoEditorPublishNativeExtension Condition="'$(InnoEditorPublishSupportPackTarget)' == 'windows-x64'">.dll</InnoEditorPublishNativeExtension>
    <InnoEditorPublishNativeToolExtension Condition="'$(InnoEditorPublishSupportPackTarget)' == 'windows-x64'">.exe</InnoEditorPublishNativeToolExtension>
  </PropertyGroup>
  <PropertyGroup>
    <_InnoBuildTasks>$(MSBuildProjectDirectory)/../../../../../build/tasks/Inno.Build.Tasks/bin/$(Configuration)/net9.0/Inno.Build.Tasks.dll</_InnoBuildTasks>
    <_InnoBuildDotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_InnoBuildDotnetHost>
    <_InnoBuildDotnetHost Condition="'$(_InnoBuildDotnetHost)' == ''">dotnet</_InnoBuildDotnetHost>
  </PropertyGroup>
  <UsingTask TaskName="Inno.Build.Tasks.PublishSupportPackTask" AssemblyFile="$(_InnoBuildTasks)" />
  <Target Name="BuildEditorPublishTasks">
    <MSBuild Projects="../../../../../build/tasks/Inno.Build.Tasks/Inno.Build.Tasks.csproj"
             Targets="Restore;Build" Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishDir" />
  </Target>
  <Target Name="BundleEditorPlayerSupportPack" AfterTargets="Publish" DependsOnTargets="BuildEditorPublishTasks"
          Condition="'$(InnoEditorPublishSupportPackTarget)' != ''">
    <PublishSupportPackTask EngineRoot="$(MSBuildProjectDirectory)/../../../../.."
                            OutputRoot="$(PublishDir)SupportPacks" Target="$(InnoEditorPublishSupportPackTarget)"
                            DotnetHost="$(_InnoBuildDotnetHost)" />
    <ItemGroup>
      <_InnoEditorBgfxNative Include="$(PublishDir)SupportPacks/$(InnoEditorPublishSupportPackTarget)/native/bgfx/$(InnoEditorPublishSupportPackTarget)/*$(InnoEditorPublishNativeExtension)" />
      <_InnoEditorSdlNative Include="$(PublishDir)SupportPacks/$(InnoEditorPublishSupportPackTarget)/native/sdl3/$(InnoEditorPublishSupportPackTarget)/*$(InnoEditorPublishNativeExtension)" />
      <_InnoEditorAudioNative Include="$(PublishDir)SupportPacks/$(InnoEditorPublishSupportPackTarget)/native/miniaudio/$(InnoEditorPublishSupportPackTarget)/*$(InnoEditorPublishNativeExtension)" />
      <_InnoEditorTextNative Include="$(PublishDir)SupportPacks/$(InnoEditorPublishSupportPackTarget)/native/text/$(InnoEditorPublishSupportPackTarget)/*$(InnoEditorPublishNativeExtension)" />
      <_InnoEditorUiNative Include="$(PublishDir)SupportPacks/$(InnoEditorPublishSupportPackTarget)/native/ui/$(InnoEditorPublishSupportPackTarget)/*$(InnoEditorPublishNativeExtension)" />
      <_InnoEditorImGuiNative Include="$(MSBuildProjectDirectory)/../../../../../.lib/cimgui/$(InnoEditorPublishNativePlatform)/*release*$(InnoEditorPublishNativeExtension)" />
      <_InnoEditorImGuizmoNative Include="$(MSBuildProjectDirectory)/../../../../../.lib/cimguizmo/$(InnoEditorPublishNativePlatform)/*release*$(InnoEditorPublishNativeExtension)" />
      <_InnoEditorBgfxShaderInclude Include="$(MSBuildProjectDirectory)/../../../../../extern/bgfx/src/bgfx_shader.sh" />
      <_InnoEditorBgfxShaderInclude Include="$(MSBuildProjectDirectory)/../../../../../extern/bgfx/src/bgfx_compute.sh" />
      <_InnoEditorBgfxShaderTool Include="$(MSBuildProjectDirectory)/../../../../../.lib/bgfx/$(InnoEditorPublishNativePlatform)/tools/shaderc-release$(InnoEditorPublishNativeToolExtension)" />
      <_InnoEditorBgfxTextureTool Include="$(MSBuildProjectDirectory)/../../../../../.lib/bgfx/$(InnoEditorPublishNativePlatform)/tools/texturec-release$(InnoEditorPublishNativeToolExtension)" />
      <_InnoEditorFrameworkReference Include="$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/**/ref/$(TargetFramework)/*.dll" />
    </ItemGroup>
    <Error Condition="'@(_InnoEditorBgfxNative)' == '' or '@(_InnoEditorSdlNative)' == '' or '@(_InnoEditorAudioNative)' == '' or '@(_InnoEditorTextNative)' == '' or '@(_InnoEditorUiNative)' == ''" Text="The published Player Support Pack has an incomplete native runtime closure." />
    <Error Condition="'@(_InnoEditorImGuiNative)' == ''" Text="The Editor distribution requires a Release ImGui native library for $(InnoEditorPublishNativePlatform)." />
    <Error Condition="'@(_InnoEditorImGuizmoNative)' == ''" Text="The Editor distribution requires a Release ImGuizmo native library for $(InnoEditorPublishNativePlatform)." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../../../../extern/bgfx/src/bgfx_shader.sh') or !Exists('$(MSBuildProjectDirectory)/../../../../../extern/bgfx/src/bgfx_compute.sh') or !Exists('$(MSBuildProjectDirectory)/../../../../../.lib/bgfx/$(InnoEditorPublishNativePlatform)/tools/shaderc-release$(InnoEditorPublishNativeToolExtension)') or !Exists('$(MSBuildProjectDirectory)/../../../../../.lib/bgfx/$(InnoEditorPublishNativePlatform)/tools/texturec-release$(InnoEditorPublishNativeToolExtension)')" Text="The Editor distribution requires BGFX shader includes and Release shaderc/texturec tools for $(InnoEditorPublishNativePlatform)." />
    <Error Condition="'@(_InnoEditorFrameworkReference)' == ''" Text="The Editor distribution requires the $(TargetFramework) framework reference pack." />
    <Copy SourceFiles="@(_InnoEditorBgfxNative)" DestinationFolder="$(PublishDir)native/bgfx/$(InnoEditorPublishNativePlatform)/" />
    <Copy SourceFiles="@(_InnoEditorSdlNative)" DestinationFolder="$(PublishDir)native/sdl3/$(InnoEditorPublishNativePlatform)/" />
    <Copy SourceFiles="@(_InnoEditorAudioNative)" DestinationFolder="$(PublishDir)native/miniaudio/$(InnoEditorPublishNativePlatform)/" />
    <Copy SourceFiles="@(_InnoEditorTextNative)" DestinationFolder="$(PublishDir)native/text/$(InnoEditorPublishNativePlatform)/" />
    <Copy SourceFiles="@(_InnoEditorUiNative)" DestinationFolder="$(PublishDir)native/ui/$(InnoEditorPublishNativePlatform)/" />
    <Copy SourceFiles="@(_InnoEditorImGuiNative)"
          DestinationFolder="$(PublishDir)native/cimgui/$(InnoEditorPublishNativePlatform)/" />
    <Copy SourceFiles="@(_InnoEditorImGuizmoNative)"
          DestinationFolder="$(PublishDir)native/cimguizmo/$(InnoEditorPublishNativePlatform)/" />
    <Copy SourceFiles="@(_InnoEditorBgfxShaderInclude)"
          DestinationFolder="$(PublishDir)native/bgfx/includes/" />
    <Copy SourceFiles="@(_InnoEditorBgfxShaderTool);@(_InnoEditorBgfxTextureTool)"
          DestinationFolder="$(PublishDir)native/bgfx/$(InnoEditorPublishNativePlatform)/tools/" />
    <Copy SourceFiles="@(_InnoEditorFrameworkReference)"
          DestinationFiles="@(_InnoEditorFrameworkReference->'$(PublishDir)packs/Microsoft.NETCore.App.Ref/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
