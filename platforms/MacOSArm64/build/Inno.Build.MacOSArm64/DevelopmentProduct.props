    <InnoDevelopmentEditorProject>$(MSBuildThisFileDirectory)../../editor/Inno.Editor.MacOSArm64/Inno.Editor.MacOSArm64.csproj</InnoDevelopmentEditorProject>
    <DefineConstants>$(DefineConstants);INNO_HOST_MACOS_ARM64</DefineConstants>
  </PropertyGroup>
</Project>
