<Project>
  <PropertyGroup>
    <InnoProductId Condition="'$(InnoProductId)' == ''">player</InnoProductId>
    <InnoProductTarget Condition="'$(InnoProductTarget)' == ''">windows-x64</InnoProductTarget>
    <InnoNativeTarget Condition="'$(InnoNativeTarget)' == ''">windows-x64</InnoNativeTarget>
    <InnoToolTarget Condition="'$(InnoToolTarget)' == ''">windows-x64</InnoToolTarget>
    <InnoProductBuildProperties>$(MSBuildThisFileDirectory)../../build/Inno.Build.WindowsX64/ProductBuild.props</InnoProductBuildProperties>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <InnoGeneratePlayerComposition>true</InnoGeneratePlayerComposition>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../integrations/Inno.Integration.WindowsX64.Bgfx.Runtime/Inno.Integration.WindowsX64.Bgfx.Runtime.csproj" PrivateAssets="compile" />
    <ProjectReference Include="../../integrations/Inno.Integration.WindowsX64.Sdl3/Inno.Integration.WindowsX64.Sdl3.csproj" PrivateAssets="compile" />

    <ProjectReference Include="../../../../src/foundation/core/Inno.Core.Execution/Inno.Core.Execution.csproj" />
    <ProjectReference Include="../../../../src/composition/player/Inno.Player.Runtime/Inno.Player.Runtime.csproj" />
    <ProjectReference Include="../../../../src/composition/adapters/Inno.Adapter.Default/Inno.Adapter.Default.csproj" />
    <ProjectReference Include="../../../../backends/FileSystem/runtime/Inno.Adapter.Content.FileSystem/Inno.Adapter.Content.FileSystem.csproj" />
    <ProjectReference Include="../../../../backends/FileSystem/runtime/Inno.Adapter.Storage.FileSystem/Inno.Adapter.Storage.FileSystem.csproj" />
    <ProjectReference Include="../../runtime/Inno.Platform.WindowsX64/Inno.Platform.WindowsX64.csproj" />
  </ItemGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="InnoGeneratePlayerComposition" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
