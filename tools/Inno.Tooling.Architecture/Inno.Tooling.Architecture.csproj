<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Markdig" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DocumentationExportCache.cs;DocumentationReferences.cs;DocumentationApiExtractor.cs;DocumentationProjectReferences.cs;DocumentationSourceModels.cs;AssemblyDocumentationProvider.cs;PublicApiDocumentationValidator.cs;RepositorySourceInventory.cs">
      <LogicalName>ApiExtractionSource/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Inno.Tooling.Documentation/Inno.Tooling.Documentation.csproj" PrivateAssets="compile" />
    <ProjectReference Include="../../src/foundation/extensibility/Inno.Extensibility.Catalogs/Inno.Extensibility.Catalogs.csproj" />
    <ProjectReference Include="../../build/toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" PrivateAssets="compile" />
    <ProjectReference Include="../../src/foundation/core/Inno.Core.IO/Inno.Core.IO.csproj" PrivateAssets="compile" />
  </ItemGroup>
</Project>
