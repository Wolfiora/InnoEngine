<Project>
  <Target
    Name="MaintainInnoRootBuildCaches"
    AfterTargets="Build;Publish"
    DependsOnTargets="PrepareInnoBuildTaskHost"
    Condition="'$(MSBuildProjectName)' == 'InnoEngine.Editor' and '$(DesignTimeBuild)' != 'true' and '$(InnoSuppressBuildMaintenance)' != 'true'">
    <Inno.Build.Tasks.MaintainBuildCachesTask EngineRoot="$(MSBuildThisFileDirectory)" />
  </Target>
  <PropertyGroup>
    <!-- SDK-inferred publish analyzers can change the restore graph. -->
    <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)build/msbuild/Inno.NuGetLockFiles.targets</AfterMicrosoftNETSdkTargets>
  </PropertyGroup>

  <!-- Only the binding owner consumes its selection as a compilation input. -->
  <Import Project="$(InnoNativeBindingSelection)" Condition="'$(BindGenGeneratedBindings)' == 'true' and '$(InnoNativeBindingSelection)' != '' and Exists('$(InnoNativeBindingSelection)')" />
  <Import Project="$(MSBuildThisFileDirectory)build/msbuild/Inno.Build.Tasks.targets" />
  <Import Project="$(MSBuildThisFileDirectory)tests/NativeProductDeployment.targets" Condition="'$(IsTestProject)' == 'true'" />

  <ItemGroup Condition="'$(BindGenGeneratedBindings)' == 'true'">
    <InnoBuildInputProject Include="$(InnoTaskPublisherProject)">
      <GlobalPropertiesToRemove>$(InnoTaskExcludedProperties);RuntimeIdentifier;InnoNativeTarget;InnoProductBuildProperties;InnoNativeBindingSelection;InnoNativeBuildFingerprint</GlobalPropertiesToRemove>
    </InnoBuildInputProject>
  </ItemGroup>

  <PropertyGroup>
    <InnoProductReferenceProperties Condition="'$(InnoNativeTarget)' != ''">InnoNativeTarget=$(InnoNativeTarget);InnoToolTarget=$(InnoToolTarget)</InnoProductReferenceProperties>
    <InnoProductReferenceProperties Condition="'$(InnoProductBuildProperties)' != ''">$(InnoProductReferenceProperties);InnoProductBuildProperties=$(InnoProductBuildProperties)</InnoProductReferenceProperties>
  </PropertyGroup>

  <!-- The SDK adds runtime references after evaluation without the direct reference's metadata. -->
  <Target Name="ApplyInnoTransitiveReferenceProperties" AfterTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <ProjectReference Update="@(_TransitiveProjectReferences)" Condition="'$(DesignTimeBuild)' != 'true'">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);InnoTaskBootstrapOwner=$(InnoTaskBootstrapOwner)</AdditionalProperties>
      </ProjectReference>
      <ProjectReference
        Update="@(_TransitiveProjectReferences)"
        Condition="'$(InnoProductReferenceProperties)' != '' and '%(ProjectReference.OutputItemType)' != 'Analyzer'">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);$(InnoProductReferenceProperties)</AdditionalProperties>
      </ProjectReference>
      <ProjectReference
        Update="@(_TransitiveProjectReferences)"
        Condition="'$(InnoNativeBindingSelection)' != '' and '%(ProjectReference.OutputItemType)' != 'Analyzer'">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);InnoNativeBindingSelection=$(InnoNativeBindingSelection)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <!-- Keep one bootstrap build owner across this project invocation. Private task loads stay distinct.
       Apply at execution time so read-only graph evaluation does not introduce transient input identities. -->
  <Target
    Name="ShareInnoTaskBootstrapOwner"
    BeforeTargets="AssignProjectConfiguration;_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences"
    AfterTargets="IncludeTransitiveProjectReferences"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);InnoTaskBootstrapOwner=$(InnoTaskBootstrapOwner)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true' and '$(IsTestProject)' != 'true' and '$(IsTestSupportProject)' != 'true' and '$(MSBuildProjectName)' != 'Inno.Scripting.Compiler' and $([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Inno.')) and !$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Inno.Native.')) and '$(TargetFramework)' != 'netstandard2.0'">
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)src/runtime/generators/Inno.Runtime.Generators/Inno.Runtime.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(InnoProductReferenceProperties)' != ''">
    <ProjectReference Update="@(ProjectReference)">
      <AdditionalProperties Condition="'%(ProjectReference.OutputItemType)' != 'Analyzer'">%(ProjectReference.AdditionalProperties);$(InnoProductReferenceProperties)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Update="@(ProjectReference)">
      <PrivateAssets Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer'">all</PrivateAssets>
      <GlobalPropertiesToRemove Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer'">%(ProjectReference.GlobalPropertiesToRemove);$(InnoCompilerToolExcludedProperties)</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup Condition="'$(BindGenGeneratedBindings)' == 'true'">
    <!-- Generated ABI carriers already own marshalling; the runtime must not reinterpret them. -->
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <BindGenOutputDirectory Condition="'$(BindGenOutputDirectory)' == ''">$(MSBuildProjectDirectory)/Generated</BindGenOutputDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BindGenGeneratedBindings)' == 'true' and '$(InnoNativeLibraryKind)' == 'Static'">
    <DefineConstants>$(DefineConstants);INNO_STATIC_NATIVE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(InnoAssemblyDomain)' != '' and '$(InnoAssemblyScope)' != ''">
    <AssemblyMetadata Include="Inno.AssemblyDomain" Value="$(InnoAssemblyDomain)" />
    <AssemblyMetadata Include="Inno.AssemblyScope" Value="$(InnoAssemblyScope)" />
  </ItemGroup>

  <ItemGroup Condition="'$(BindGenGeneratedBindings)' == 'true'">
    <Compile Remove="$(MSBuildProjectDirectory)/Bindings/**/*.cs" />
    <Compile Remove="$(MSBuildProjectDirectory)/Generated/**/*.cs" />
    <Compile Include="$(BindGenOutputDirectory)/Bindings.cs" Link="Generated/Bindings.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(BindGenGeneratedBindings)' == 'true'">
    <InnoBindingEngineRoot Condition="'$(InnoBindingEngineRoot)' == ''">$(MSBuildThisFileDirectory)</InnoBindingEngineRoot>
    <InnoBindingDefinition Condition="'$(InnoBindingDefinition)' == ''">$(MSBuildProjectDirectory)/Bindings/bindings.props</InnoBindingDefinition>
    <InnoBindingTargetId Condition="'$(InnoBindingTargetId)' == '' and '$(InnoNativeTarget)' != ''">$(InnoNativeTarget)</InnoBindingTargetId>
    <InnoBindingTargetId Condition="'$(InnoBindingTargetId)' == ''">$(InnoDevelopmentTarget)</InnoBindingTargetId>
    <InnoBindingOutputMode Condition="'$(InnoBindingOutputMode)' == '' and '$(InnoNativeTarget)' != ''">TargetArtifacts</InnoBindingOutputMode>
    <InnoBindingOutputMode Condition="'$(InnoBindingOutputMode)' == ''">HostSource</InnoBindingOutputMode>
    <InnoBindingDotnetHost Condition="'$(InnoBindingDotnetHost)' == ''">$(DOTNET_HOST_PATH)</InnoBindingDotnetHost>
    <InnoBindingDotnetHost Condition="'$(InnoBindingDotnetHost)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildBinPath)/../../dotnet'))</InnoBindingDotnetHost>
  </PropertyGroup>

  <Target Name="ValidateNativeBindingSelection" BeforeTargets="CoreCompile" Condition="'$(InnoNativeBindingSelection)' != ''">
    <Error Condition="!Exists('$(InnoNativeBindingSelection)')" Text="The selected native binding manifest is missing: $(InnoNativeBindingSelection)" />
  </Target>

  <Target Name="ValidateBindingGenerator" Condition="'$(BindGenGeneratedBindings)' == 'true'">
    <Error Condition="!Exists('$(InnoBindingDefinition)')" Text="The sole component binding definition is missing: $(InnoBindingDefinition)" />
    <Error Condition="'$(InnoBindingConfig)' == ''" Text="The component binding definition must declare its common configuration." />
  </Target>

  <Target Name="BuildBindingGenerator" DependsOnTargets="ValidateBindingGenerator;PrepareInnoBuildTaskHost" Condition="'$(BindGenGeneratedBindings)' == 'true' and '$(DesignTimeBuild)' != 'true'" />

  <Target Name="GenerateBindings" DependsOnTargets="BuildBindingGenerator" Condition="'$(BindGenGeneratedBindings)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Inno.Build.Tasks.GenerateBindingsTask
      EngineRoot="$(InnoBindingEngineRoot)"
      ComponentProject="$(MSBuildProjectFullPath)"
      ComponentId="$(InnoNativeComponentId)"
      BindingDefinition="$(InnoBindingDefinition)"
      TargetId="$(InnoBindingTargetId)"
      OutputMode="$(InnoBindingOutputMode)"
      DotnetHost="$(InnoBindingDotnetHost)"
      DescriptorOutputPath="$(BindGenDescriptorOutput)"
      ExpectedFingerprint="$(BindGenExpectedFingerprint)">
      <Output TaskParameter="GeneratedBindings" PropertyName="BindGenGeneratedSource" />
      <Output TaskParameter="GenerationFingerprint" PropertyName="BindGenGenerationFingerprint" />
      <Output TaskParameter="GenerationFingerprint" PropertyName="BindGenExpectedFingerprint" />
      <Output TaskParameter="UsesRuntimeImports" PropertyName="_BindGenUsesRuntimeImports" />
      <Output TaskParameter="ArtifactDirectory" PropertyName="BindGenArtifactDirectory" />
      <Output TaskParameter="ArtifactOwnerDirectory" PropertyName="BindGenArtifactOwnerDirectory" />
      <Output TaskParameter="NativeDirectory" PropertyName="BindGenNativeDirectory" />
    </Inno.Build.Tasks.GenerateBindingsTask>
    <Error
      Condition="'$(InnoNativeBindingSelection)' != '' and '$(_BindGenUsesRuntimeImports)' != '$(InnoNativeRuntimeImports)'"
      Text="The selected native import initialization differs from the generated binding contract." />
    <PropertyGroup>
      <BindGenOutputDirectory>$([System.IO.Path]::GetDirectoryName('$(BindGenGeneratedSource)'))</BindGenOutputDirectory>
      <InnoNativeRuntimeImports Condition="'$(InnoNativeBindingSelection)' == ''">$(_BindGenUsesRuntimeImports)</InnoNativeRuntimeImports>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Compile.Filename)%(Compile.Extension)' == 'Bindings.cs'" />
      <Compile Include="$(BindGenGeneratedSource)" Link="Generated/Bindings.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CheckBindings" DependsOnTargets="BuildBindingGenerator" Condition="'$(BindGenGeneratedBindings)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Inno.Build.Tasks.GenerateBindingsTask
      EngineRoot="$(InnoBindingEngineRoot)"
      ComponentProject="$(MSBuildProjectFullPath)"
      ComponentId="$(InnoNativeComponentId)"
      BindingDefinition="$(InnoBindingDefinition)"
      TargetId="$(InnoBindingTargetId)"
      OutputMode="$(InnoBindingOutputMode)"
      DotnetHost="$(InnoBindingDotnetHost)"
      CheckOnly="true"
      ExpectedFingerprint="$(BindGenExpectedFingerprint)" />
  </Target>

  <Target
    Name="EnsureBindGenBindings"
    DependsOnTargets="GenerateBindings"
    Condition="'$(BindGenGeneratedBindings)' == 'true' and '$(DesignTimeBuild)' != 'true' and (('$(InnoBindingOutputMode)' == 'TargetArtifacts' and '$(InnoNativeBindingSelection)' == '') or !Exists('$(BindGenOutputDirectory)/Bindings.cs'))" />

  <Target
    Name="MaterializeBindGenBindings"
    DependsOnTargets="EnsureBindGenBindings;PrepareInnoTaskPublisher"
    Condition="'$(BindGenGeneratedBindings)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Inno.Build.TaskHosting.MaterializeBindingsTask
      Source="$([System.IO.Path]::GetFullPath('$(BindGenOutputDirectory)/Bindings.cs'))"
      IntermediateDirectory="$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(MSBuildProjectDirectory)'))"
      ComponentProject="$(MSBuildProjectFullPath)"
      ArtifactDirectory="$(BindGenArtifactDirectory)"
      ArtifactOwnerDirectory="$(BindGenArtifactOwnerDirectory)"
      Fingerprint="$(BindGenExpectedFingerprint)">
      <Output TaskParameter="MaterializedSource" PropertyName="BindGenCompileSource" />
    </Inno.Build.TaskHosting.MaterializeBindingsTask>
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Compile.Filename)%(Compile.Extension)' == 'Bindings.cs'" />
      <Compile Include="$(BindGenCompileSource)" Link="Generated/Bindings.cs" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateBindGenBindings" BeforeTargets="CoreCompile" DependsOnTargets="EnsureBindGenBindings;MaterializeBindGenBindings" Condition="'$(BindGenGeneratedBindings)' == 'true'">
    <Error
      Condition="'$(InnoNativeBindingSelection)' != '' and '$(InnoNativeRuntimeImports)' != 'true' and '$(InnoNativeRuntimeImports)' != 'false'"
      Text="The selected native component must declare its generated import initialization." />
    <PropertyGroup>
      <DefineConstants Condition="'$(InnoNativeRuntimeImports)' == 'true'">$(DefineConstants);INNO_RUNTIME_IMPORTS</DefineConstants>
    </PropertyGroup>
    <Error
      Condition="'$(InnoNativeBindingSelection)' != '' and '$(InnoNativeLibraryKind)' != 'Static' and '$(InnoNativeLibraryKind)' != 'Shared'"
      Text="The selected native component must declare its exact Static or Shared linkage." />
    <ItemGroup>
      <_BindGenExtraSources Include="$(BindGenOutputDirectory)/**/*.cs" Exclude="$(BindGenOutputDirectory)/Bindings.cs" />
      <_BindGenCompileSources Include="@(Compile)" Condition="'%(Compile.Filename)%(Compile.Extension)' == 'Bindings.cs'" />
    </ItemGroup>
    <Error Condition="'@(_BindGenExtraSources)' != ''" Text="Generated must contain only Bindings.cs: @(_BindGenExtraSources)" />
    <Error Condition="'@(_BindGenCompileSources->Count())' != '1'" Text="The native component must compile exactly one selected Bindings.cs source: @(_BindGenCompileSources)" />
  </Target>

  <Target
    Name="RestoreProductTargetGraph"
    BeforeTargets="PrepareForBuild"
    DependsOnTargets="PrepareInnoTaskPublisher"
    Condition="'$(InnoProductId)' != '' and '$(DesignTimeBuild)' != 'true' and '$(InnoProductRestore)' != 'false'">
    <Inno.Build.TaskHosting.RestoreOwnedProjectTask
      Projects="$(MSBuildProjectFullPath)"
      Properties="InnoNativeTarget=$(InnoProductTarget);InnoToolTarget=$(InnoToolTarget);InnoProductRestore=false"
      LockPath="$(MSBuildThisFileDirectory)artifacts/managed/restore-graphs/write.lock" />
  </Target>

  <Target
    Name="ValidateProductTarget"
    BeforeTargets="PrepareForBuild"
    Condition="'$(InnoProductId)' != '' and '$(DesignTimeBuild)' != 'true'">
    <Error
      Condition="'$(InnoProductTarget)' == '' or '$(InnoNativeTarget)' != '$(InnoProductTarget)'"
      Text="The product requires its explicit matching native target." />
  </Target>

  <Target
    Name="PrepareProductNativeDeployment"
    BeforeTargets="AssignProjectConfiguration"
    DependsOnTargets="PrepareInnoBuildTaskHost"
    Condition="'$(InnoProductId)' != '' and '$(InnoPrepareProductNative)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(InnoNativeBindingSelection)' == ''">
    <PropertyGroup>
      <_InnoOwnedProductBindingSelection>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)NativeBindingSelection.props', '$(MSBuildProjectDirectory)'))</_InnoOwnedProductBindingSelection>
    </PropertyGroup>
    <Inno.Build.Tasks.PrepareProductNativeTask
      EngineRoot="$(MSBuildThisFileDirectory)"
      ProductId="$(InnoProductId)"
      TargetId="$(InnoProductTarget)"
      Configuration="$(Configuration)"
      BindingSelectionOutputPath="$(_InnoOwnedProductBindingSelection)"
      OutputDirectory="$(TargetDir)" />
    <PropertyGroup>
      <InnoNativeBindingSelection>$(_InnoOwnedProductBindingSelection)</InnoNativeBindingSelection>
    </PropertyGroup>
    <ItemGroup>
      <ProjectReference Condition="'%(ProjectReference.OutputItemType)' != 'Analyzer'">
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);InnoNativeBindingSelection=$(InnoNativeBindingSelection)</AdditionalProperties>
      </ProjectReference>
      <_MSBuildProjectReferenceExistent Condition="'%(_MSBuildProjectReferenceExistent.OutputItemType)' != 'Analyzer'">
        <AdditionalProperties>%(_MSBuildProjectReferenceExistent.AdditionalProperties);InnoNativeBindingSelection=$(InnoNativeBindingSelection)</AdditionalProperties>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

  <Target
    Name="ExposeInnoHostRuntimeClosure"
    BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems"
    DependsOnTargets="GenerateBuildDependencyFile"
    Condition="'$(InnoExposeRuntimeClosure)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ContentWithTargetPath
        Include="$(ProjectDepsFilePath)"
        TargetPath="$(ProjectDepsFileName)"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest" />
      <ContentWithTargetPath
        Include="@(ReferenceCopyLocalPaths)"
        TargetPath="%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target
    Name="CollectProductNativeDeployment"
    BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems"
    Condition="'$(InnoProductId)' != '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_InnoProductNativeFile Include="$(TargetDir)native/**/*" />
      <ContentWithTargetPath Include="@(_InnoProductNativeFile)">
        <TargetPath>native/%(_InnoProductNativeFile.RecursiveDir)%(_InnoProductNativeFile.Filename)%(_InnoProductNativeFile.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <Target
    Name="ValidateProductNativePublication"
    BeforeTargets="PrepareForPublish"
    Condition="'$(InnoProductId)' != '' and '$(InnoPrepareProductNative)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <Error
      Condition="'$(InnoNativeBindingSelection)' == '' or !Exists('$(InnoNativeBindingSelection)')"
      Text="Native publication requires the exact binding selection used by managed compilation. A no-build publication must explicitly provide that selection." />
  </Target>

  <Target
    Name="PublishProductNativeDeployment"
    AfterTargets="Publish"
    DependsOnTargets="ValidateProductNativePublication;PrepareInnoBuildTaskHost"
    Condition="'$(InnoProductId)' != '' and '$(InnoPrepareProductNative)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <Inno.Build.Tasks.PrepareProductNativeTask
      EngineRoot="$(MSBuildThisFileDirectory)"
      ProductId="$(InnoProductId)"
      TargetId="$(InnoProductTarget)"
      Configuration="$(Configuration)"
      BindingSelectionInputPath="$(InnoNativeBindingSelection)"
      OutputDirectory="$(PublishDir)" />
  </Target>
</Project>
